# ==========================================
# Autoryx Configuration (.env.example)
# ==========================================

# Target GitHub Repository (Highorder-Thinking / Step_semester_3)
GITHUB_OWNER=Highorder-Thinking
GITHUB_REPO=Step_semester_3
GITHUB_DEFAULT_BRANCH=main

# GitHub Personal Access Token (Requires Contents: Read & Write)
# Leave empty initially; can also be configured via Settings in the Web UI
GITHUB_TOKEN=

# Directory name for strictly isolated assignments
TARGET_ISOLATED_DIR=STEP_Agent_Assignments

# AI Provider Configuration ("gemini", "openai", or "mock" for zero-cost offline tests)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Validation & Sandboxing
MAX_REPAIR_ATTEMPTS=2
COMPILATION_TIMEOUT_SECONDS=15
EXECUTION_TIMEOUT_SECONDS=5
AUTO_PUBLISH_BRANCH=false

# Database & Cache (Defaults to local SQLite and local in-process queue if empty)
# PostgreSQL for Docker/Cloud: postgresql://autoryx:autoryx_secure_password@localhost:5432/autoryx
DATABASE_URL=sqlite:///./autoryx.db
REDIS_URL=redis://localhost:6379/0
